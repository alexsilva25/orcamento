<!doctype html>
<html lang="pt-BR">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Crie orçamentos de equipamentos e serviços de segurança."/><title>Orçamentos | Segurança</title></head>
<body>
<aside class="sidebar"><a class="brand" href="/">◈ <span>Orça<span class="accent">Seg</span></span></a><div class="nav-label">ÁREA DE TRABALHO</div><div class="nav-active">▤ &nbsp; Orçamentos</div><p class="side-note">Do projeto à proposta.<br/>Seu próximo negócio começa aqui.</p><div class="local-badge">● Armazenamento local</div></aside>
<main><header><div><div class="eyebrow">GESTÃO COMERCIAL / ORÇAMENTOS</div><h1>Uma proposta. Novas possibilidades.</h1><p>Monte seu orçamento de segurança com clareza e agilidade.</p></div><button id="new" class="secondary">＋ Novo orçamento</button></header>
<div class="toolbar"><span class="status">● Rascunho</span><span id="number"></span><span class="privacy">Seus dados ficam neste navegador</span></div>
<form id="quote"><div class="layout"><div class="editor">
<section><div class="section-title"><span class="step">01</span><div><h2>Quem está por trás da proposta?</h2><p>Os dados da sua empresa aparecem na impressão.</p></div></div><div class="grid"><label>Empresa<input name="company" placeholder="Nome da sua empresa" maxlength="160"/></label><label>Telefone / WhatsApp<input name="companyPhone" type="tel" placeholder="(85) 99999-9999"/></label></div></section>
<section><div class="section-title"><span class="step">02</span><div><h2>Dados do cliente</h2><p>Prepare uma proposta com atenção aos detalhes.</p></div></div><div class="grid"><label>Nome ou razão social<input name="client" placeholder="Para quem é esta proposta?" required maxlength="160"/></label><label>Telefone<input name="phone" type="tel" placeholder="Telefone do cliente"/></label><label class="wide">Endereço da instalação<input name="address" placeholder="Rua, número, bairro e cidade"/></label><label>Data de emissão<input name="date" type="date" required/></label><label>Validade (dias)<input name="validity" type="number" min="1" max="365" value="15" required/></label></div></section>
<section><div class="section-title"><span class="step">03</span><div><h2>Equipamentos e serviços</h2><p>Adicione tudo que faz parte do projeto.</p></div></div><div class="catalog"><span>Adicionar rápido</span><button type="button" data-preset="Câmera de segurança">＋ Câmera</button><button type="button" data-preset="Gravador DVR / NVR">＋ Gravador</button><button type="button" data-preset="Kit de alarme">＋ Alarme</button><button type="button" data-preset="Serviço de instalação">＋ Instalação</button></div><div class="table-scroll"><table><thead><tr><th>Descrição</th><th>Qtd.</th><th>Unitário (R$)</th><th>Total</th><th><span class="sr-only">Ações</span></th></tr></thead><tbody id="items"></tbody></table></div><button type="button" id="add" class="add-item">＋ Adicionar item personalizado</button></section>
<section><div class="section-title"><span class="step">04</span><div><h2>Condições da proposta</h2><p>Combine os próximos passos com seu cliente.</p></div></div><div class="grid"><label>Forma de pagamento<input name="payment" placeholder="Ex.: 50% na aprovação e 50% na entrega"/></label><label>Prazo de execução<input name="deadline" placeholder="Ex.: 5 dias úteis após aprovação"/></label><label class="wide">Observações e garantia<textarea name="notes" rows="4" placeholder="Descreva o escopo, a garantia e o que está incluído."></textarea></label></div></section>
</div><aside class="summary"><div class="eyebrow">VISÃO GERAL</div><h2>Resumo da proposta</h2><div class="summary-line"><span>Equipamentos e serviços</span><strong id="subtotal"></strong></div><label>Desconto (R$)<input name="discount" type="number" value="0" min="0" step="0.01" required/></label><label>Deslocamento / outros (R$)<input name="extra" type="number" value="0" min="0" step="0.01" required/></label><div class="total"><span>Total do orçamento</span><strong id="total"></strong></div><button type="submit" class="primary">Salvar orçamento <span>↗</span></button><button type="button" id="print" class="secondary">Imprimir / Salvar PDF</button><p id="feedback" role="status" aria-live="polite">Preencha os dados para começar.</p><div class="tip">✧ <strong>Uma boa proposta gera confiança.</strong><p>Informe os modelos dos equipamentos e detalhe os serviços incluídos.</p></div></aside></div></form>
<section class="saved"><div class="section-title"><div><h2>Orçamentos salvos</h2><p>Continue de onde parou neste navegador.</p></div></div><div id="saved-list"></div></section><footer>OrçaSeg · Organização para fechar bons negócios.</footer></main><article id="print-area"></article>
<script>
type Item = {description:string; qty:number; price:number};
type Quote = {id:string; fields:Record<string,string>; items:Item[]};
const form=document.querySelector<HTMLFormElement>('#quote')!;
const $=(s:string)=>document.querySelector<HTMLElement>(s)!;
const money=(n:number)=>new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(n);
const storageKey='orcaseg-quotes-v1';
let id='',items:Item[]=[],saved:Quote[]=[];
const feedback=(s:string)=>{$('#feedback').textContent=s};
function field(name:string){return form.elements.namedItem(name) as HTMLInputElement;}
function load(){try {const data=JSON.parse(localStorage.getItem(storageKey)||'[]'); if(!Array.isArray(data))throw Error(); saved=data.filter(q=>q && typeof q.id==='string' && q.fields && typeof q.fields==='object' && Array.isArray(q.items) && q.items.every((i:Item)=>typeof i.description==='string'&&Number.isFinite(i.qty)&&i.qty>0&&Number.isFinite(i.price)&&i.price>=0));}catch{feedback('Não foi possível ler os dados locais. Exporte propostas importantes como PDF.');}}
function totals(){const sub=items.reduce((sum,i)=>sum+i.qty*i.price,0); const total=Math.max(0,sub+Math.max(0,Number(field('extra').value)||0)-Math.max(0,Number(field('discount').value)||0)); $('#subtotal').textContent=money(sub);$('#total').textContent=money(total);return {sub,total};}
function renderItems(){const body=$('#items');body.replaceChildren(); items.forEach((item,index)=>{const row=document.createElement('tr');(['description','qty','price'] as const).forEach(key=>{const td=document.createElement('td'),input=document.createElement('input');input.type=key==='description'?'text':'number';input.value=String(item[key]);input.required=true;input.setAttribute('aria-label',({description:'Descrição',qty:'Quantidade',price:'Preço unitário'})[key]+' do item '+(index+1)); if(key!=='description'){input.min=key==='qty'?'0.01':'0';input.step='0.01';}input.addEventListener('input',()=>{if(key==='description')item.description=input.value;else item[key]=Number(input.value); amount.textContent=money(item.qty*item.price);totals();});td.append(input);row.append(td);});const amount=document.createElement('td');amount.className='item-total';amount.textContent=money(item.qty*item.price);row.append(amount);const td=document.createElement('td'),remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.className='remove';remove.setAttribute('aria-label','Remover item '+(index+1));remove.onclick=()=>{items.splice(index,1);renderItems();};td.append(remove);row.append(td);body.append(row);});totals();}
function reset(){form.reset();id=crypto.randomUUID();field('date').value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);items=[{description:'',qty:1,price:0}];$('#number').textContent='Proposta #'+id.slice(0,8).toUpperCase();renderItems();feedback('Novo orçamento iniciado.');}
function renderSaved(){const root=$('#saved-list');root.replaceChildren();if(!saved.length){root.textContent='Nenhum orçamento salvo ainda.';return;}saved.forEach(q=>{const row=document.createElement('div');row.className='saved-row';const title=document.createElement('span');title.textContent=(q.fields.client||'Cliente sem nome')+' · '+(q.fields.date||'')+' · #'+q.id.slice(0,8).toUpperCase();const open=document.createElement('button');open.type='button';open.textContent='Abrir';open.onclick=()=>{form.reset();id=q.id;Object.entries(q.fields).forEach(([name,value])=>{const input=form.elements.namedItem(name);if(input instanceof HTMLInputElement||input instanceof HTMLTextAreaElement)input.value=String(value);});items=structuredClone(q.items);$('#number').textContent='Proposta #'+id.slice(0,8).toUpperCase();renderItems();feedback('Orçamento carregado.');window.scrollTo({top:0,behavior:'smooth'});};const del=document.createElement('button');del.type='button';del.textContent='Excluir';del.onclick=()=>{if(!confirm('Excluir o orçamento de '+(q.fields.client||'este cliente')+'?'))return;const next=saved.filter(x=>x.id!==q.id);try{localStorage.setItem(storageKey,JSON.stringify(next));saved=next;renderSaved();feedback('Orçamento excluído.');}catch{feedback('Não foi possível excluir. Verifique o armazenamento do navegador.');}};row.append(title,open,del);root.append(row);});}
function validate(){if(!form.reportValidity())return false;if(!items.length||items.some(i=>!i.description.trim()||!Number.isFinite(i.qty)||i.qty<=0||!Number.isFinite(i.price)||i.price<0)){feedback('Adicione ao menos um item com descrição, quantidade e preço válidos.');return false;}const sub=totals().sub;if(Number(field('discount').value)>sub+Number(field('extra').value)){feedback('O desconto não pode exceder o valor da proposta.');return false;}return true;}
$('#add').onclick=()=>{items.push({description:'',qty:1,price:0});renderItems();};document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button=>button.onclick=()=>{const item={description:button.dataset.preset!,qty:1,price:0};if(items.length===1&&!items[0].description&&items[0].price===0)items=[item];else items.push(item);renderItems();});
form.addEventListener('input',()=>{totals();feedback('Alterações ainda não salvas.');});
form.onsubmit=event=>{event.preventDefault();if(!validate())return;const quote={id,fields:Object.fromEntries(new FormData(form).entries()) as Record<string,string>,items:structuredClone(items)};const next=[quote,...saved.filter(q=>q.id!==id)];try{localStorage.setItem(storageKey,JSON.stringify(next));saved=next;renderSaved();feedback('Orçamento salvo neste navegador.');}catch{feedback('Não foi possível salvar. O armazenamento pode estar cheio ou bloqueado. Salve um PDF.');}};
$('#new').onclick=()=>{if(confirm('Iniciar novo orçamento? Salve suas alterações antes de continuar.'))reset();};
$('#print').onclick=()=>{if(!validate())return;const root=$('#print-area');root.replaceChildren();const text=(tag:string,value:string)=>{const el=document.createElement(tag);el.textContent=value;root.append(el);};text('h1',field('company').value||'Proposta comercial');text('p',field('companyPhone').value);text('h2','Orçamento #'+id.slice(0,8).toUpperCase());text('p','Emissão: '+field('date').value.split('-').reverse().join('/')+' · Validade: '+field('validity').value+' dias');text('h3',field('client').value);text('p',field('phone').value);text('p',field('address').value);const table=document.createElement('table');const header=document.createElement('tr');['Descrição','Qtd.','Valor unitário','Total'].forEach(t=>{const th=document.createElement('th');th.textContent=t;header.append(th);});table.append(header);items.forEach(i=>{const row=document.createElement('tr');[i.description,String(i.qty),money(i.price),money(i.qty*i.price)].forEach(value=>{const td=document.createElement('td');td.textContent=value;row.append(td);});table.append(row);});root.append(table);text('p','Subtotal: '+money(totals().sub)+' · Desconto: '+money(Number(field('discount').value))+' · Outros: '+money(Number(field('extra').value)));text('h2','Total: '+money(totals().total));text('p','Pagamento: '+(field('payment').value||'A combinar'));text('p','Prazo: '+(field('deadline').value||'A combinar'));text('p',field('notes').value);text('p','Aceite do cliente: ____________________________________');window.print();};
reset();load();renderSaved();
</script>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#182a2b;background:#f5f7f7;font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid #25aa90;outline-offset:3px}.sidebar{position:fixed;inset:0 auto 0 0;width:225px;background:#112f30;color:#d6e8e3;padding:36px 25px;display:flex;flex-direction:column}.brand{color:#fff;text-decoration:none;font:800 28px Manrope,sans-serif;display:flex;gap:12px;align-items:center}.brand> :first-child{letter-spacing:-1px}.accent{color:#87dcc1}.nav-label{font-size:10px;letter-spacing:1.8px;color:#89a6a1;margin-top:65px;margin-bottom:18px}.nav-active{background:#244344;border:1px solid #385654;border-radius:8px;padding:14px;font-size:14px}.side-note{font-size:12px;line-height:1.9;color:#9bb5b0;margin-top:auto}.local-badge{font-size:10px;color:#a7d7c6;border-top:1px solid #31504d;padding-top:22px;margin-top:25px}main{margin-left:225px;padding:48px 42px;max-width:1550px}header{display:flex;align-items:center;justify-content:space-between;gap:24px}.eyebrow{font-size:10px;letter-spacing:1.6px;color:#60817a;font-weight:700}h1{font:800 clamp(24px,2.3vw,33px)/1.3 Manrope,sans-serif;letter-spacing:-1.2px;margin:13px 0}header p,.section-title p{font-size:13px;color:#778783;margin:0;line-height:1.6}button{border:0;border-radius:7px;background:#ecf1ef;color:#34534b;padding:10px 13px;font-size:12px;font-weight:600}.secondary{background:white;border:1px solid #d9e2de;padding:13px 18px;white-space:nowrap}.toolbar{display:flex;gap:15px;align-items:center;margin:30px 0 20px;font-size:11px;color:#71827e}.status{background:#fff1d8;color:#9a6c19;padding:6px 11px;border-radius:5px}.privacy{margin-left:auto}.layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:24px}.editor{display:grid;gap:20px}section,.summary{background:white;border:1px solid #e0e7e3;border-radius:11px;padding:25px}.section-title{display:flex;align-items:flex-start;gap:13px;margin-bottom:24px}h2{font:700 16px Manrope,sans-serif;margin:0 0 6px;letter-spacing:-.3px}.step{display:grid;place-items:center;flex-shrink:0;background:#ecf5ef;color:#42715a;border-radius:8px;width:32px;height:32px;font-size:11px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.wide{grid-column:1/-1}label{display:flex;flex-direction:column;gap:8px;font-size:11px;font-weight:600;color:#50615a}input,textarea{width:100%;min-width:0;border:1px solid #dce5df;background:#fff;border-radius:6px;padding:11px 12px;font-size:12px;color:#213a30;outline:none}input:focus,textarea:focus{border-color:#27876d;box-shadow:0 0 0 3px #e9f5ed}input::placeholder,textarea::placeholder{color:#9aa69e;font-weight:400}.catalog{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:20px}.catalog>span{font-size:10px;color:#88978d;margin-right:4px}.catalog button{font-size:10px;padding:7px 9px;border:1px solid #dce7df;background:#f5f8f5}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:11px}th{text-align:left;padding:10px 5px;background:#f5f7f5;color:#7a897d;font-size:10px;font-weight:500}td{padding:12px 4px;border-bottom:1px solid #edf0ec}td:first-child{min-width:150px}td:nth-child(2){width:65px}td:nth-child(3){width:100px}td input{padding:9px 7px}.item-total{white-space:nowrap;font-size:11px}.remove{background:none;color:#ac6c66;font-size:19px;padding:5px}.add-item{background:none;color:#338469;margin-top:15px;padding-left:0;font-size:11px}.summary{align-self:start;position:sticky;top:24px;padding:25px 22px}.summary h2{margin-top:12px;margin-bottom:28px}.summary-line{display:flex;justify-content:space-between;gap:8px;font-size:11px;margin-bottom:25px;color:#74847a}.summary-line strong{color:#314a3a;white-space:nowrap}.summary label{margin:16px 0}.total{border-top:1px dashed #d4dfd5;margin-top:24px;padding:23px 0;display:flex;flex-direction:column;gap:8px}.total span{font-size:11px;color:#6c7e70}.total strong{font:800 32px Manrope,sans-serif;color:#153f31;letter-spacing:-1px}.primary{display:flex;justify-content:space-between;width:100%;background:#1e634d;color:white;padding:14px 15px}.summary .secondary{width:100%;margin-top:10px}.summary #feedback{font-size:10px;color:#6a7d6d;text-align:center;line-height:1.6;min-height:32px}.tip{margin-top:22px;background:#f3f7ef;border:1px solid #e6eddf;padding:15px;border-radius:7px;font-size:11px;color:#58724d;line-height:1.6}.tip p{margin-bottom:0;font-size:10px;color:#809176}.saved{margin-top:25px}.saved-row{display:flex;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #edf0ec;font-size:12px}.saved-row span{flex:1;overflow-wrap:anywhere}#saved-list{font-size:12px;color:#718176}footer{text-align:center;color:#93a194;font-size:10px;margin-top:35px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}#print-area{display:none}@media(min-width:1500px){main{margin-right:auto}}@media(max-width:1150px){.sidebar{width:180px;padding:30px 18px}main{margin-left:180px;padding:35px 25px}.layout{grid-template-columns:minmax(0,1fr) 255px}header{align-items:flex-start}section{padding:20px}}@media(max-width:900px){.sidebar{position:static;width:auto;padding:18px 24px;display:block}.brand{font-size:23px}.nav-label,.nav-active,.side-note,.local-badge{display:none}main{margin:0;padding:28px 20px}.layout{grid-template-columns:1fr}.summary{position:static}.privacy{display:none}header{flex-direction:column;gap:12px}.summary-line{font-size:13px}.summary #feedback{font-size:12px}.total strong{font-size:36px}}@media(max-width:480px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}section,.summary{padding:18px}main{padding:24px 12px}h1{font-size:25px}.saved-row{flex-wrap:wrap}.saved-row span{flex-basis:100%}}
@media print{@page{size:A4;margin:18mm}body{background:white;font-family:Arial,sans-serif;color:#111}.sidebar,main{display:none!important}#print-area{display:block}#print-area h1{font-size:25px}#print-area h2{font-size:19px;margin-top:24px}#print-area p{font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.6}#print-area table{margin:25px 0;font-size:12px}#print-area th,#print-area td{padding:10px 6px;border-bottom:1px solid #ccc;width:auto}#print-area tr{break-inside:avoid}#print-area th{background:#eee;color:#111}}
</style>
</body></html>
