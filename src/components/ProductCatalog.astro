---
import catalog from '../data/products.json';
const categories = [...new Set(catalog.products.map(p => p.category))];
const formatPrice = (value: number) => new Intl.NumberFormat('pt-BR', {style:'currency',currency:'BRL'}).format(value);
const date = new Date(catalog.fetchedAt).toLocaleDateString('pt-BR', {timeZone:'America/Fortaleza'});
const brands = [...new Set(catalog.products.map(p => p.brand))].sort((a,b)=>a.localeCompare(b,'pt-BR'));
const productDate = (value: string) => new Date(value).toLocaleDateString('pt-BR', {timeZone:'America/Fortaleza'});
---
<section id="product-catalog" class="product-catalog">
  <div class="catalog-heading"><div><div class="eyebrow">EQUIPAMENTOS PARA SEU PROJETO</div><h2>Catálogo de produtos</h2><p>{catalog.products.length} produtos com fotografias reais e preços pesquisados.</p></div><a href="#quote" class="back-to-quote">↑ Voltar ao orçamento</a></div>
  <p class="price-notice">Catálogo ampliado em {date}. Valores de referência sem frete, instalação ou margem de revenda. Cada produto informa a data da pesquisa, a loja e a condição do preço. Confira a oferta na fonte e ajuste seu valor de venda no orçamento. A quantidade e a embalagem correspondem ao anúncio: unidade, par, rolo ou kit, conforme a descrição.</p>
  <div class="catalog-filters"><div class="filter-field"><label for="product-search">Buscar produto</label><input id="product-search" type="search" placeholder="Busque por modelo, produto ou marca…"/></div><div class="filter-field"><label for="product-category">Categoria</label><select id="product-category"><option value="">Todas as categorias</option>{categories.map(c=><option value={c}>{c}</option>)}</select></div><div class="filter-field"><label for="product-brand">Marca</label><select id="product-brand"><option value="">Todas as marcas</option>{brands.map(b=><option value={b}>{b}</option>)}</select></div></div>
  <p id="product-results" role="status" aria-live="polite"></p>
  <div class="product-grid">{catalog.products.map(p=><article class="product-card" data-name={p.name} data-brand={p.brand} data-category={p.category}>
    <div class="product-photo"><img src={p.image} alt={p.name} width="240" height="180" loading="lazy" decoding="async"/></div>
    <div class="product-card-body"><span class="product-category">{p.category}</span><h3>{p.name}</h3><span class="product-brand">{p.brand}</span><strong class="product-price">{formatPrice(p.price)}</strong><span class="product-condition">{p.priceBasis} · Sem frete</span><span class="product-condition">Pesquisado em {productDate(p.fetchedAt)}</span><a href={p.source} target="_blank" rel="noopener noreferrer" class="product-source">Fonte: {p.sourceName} ↗</a><button type="button" class="product-add" data-product-name={p.name} data-product-price={p.price} data-product-id={p.id} data-product-image={p.image}>＋ Adicionar ao orçamento</button></div>
  </article>)}</div>
  <div class="catalog-pagination"><button type="button" id="products-prev">← Anterior</button><span id="products-page"></span><button type="button" id="products-next">Próxima →</button></div>
  <p id="catalog-feedback" role="status" aria-live="polite"></p>
</section>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')];
const search=document.querySelector<HTMLInputElement>('#product-search')!;
const category=document.querySelector<HTMLSelectElement>('#product-category')!;
const brand=document.querySelector<HTMLSelectElement>('#product-brand')!;
const previous=document.querySelector<HTMLButtonElement>('#products-prev')!;
const next=document.querySelector<HTMLButtonElement>('#products-next')!;
const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
let page=0;const pageSize=12;
function render(){const terms=normalize(search.value.trim()).split(/\s+/).filter(Boolean);const filtered=cards.filter(c=>terms.every(term=>normalize(`${c.dataset.name} ${c.dataset.brand} ${c.dataset.category}`).includes(term))&&(!category.value||c.dataset.category===category.value)&&(!brand.value||c.dataset.brand===brand.value));const pages=Math.max(1,Math.ceil(filtered.length/pageSize));page=Math.min(page,pages-1);const visible=new Set(filtered.slice(page*pageSize,(page+1)*pageSize));cards.forEach(c=>c.hidden=!visible.has(c));document.querySelector('#product-results')!.textContent=`${filtered.length} produto(s) encontrado(s)`;document.querySelector('#products-page')!.textContent=`Página ${page+1} de ${pages}`;previous.disabled=page===0;next.disabled=page>=pages-1;}
search.addEventListener('input',()=>{page=0;render();});category.addEventListener('change',()=>{page=0;render();});brand.addEventListener('change',()=>{page=0;render();});
previous.onclick=()=>{page--;render();document.querySelector('#product-catalog')!.scrollIntoView({behavior:'smooth'});};next.onclick=()=>{page++;render();document.querySelector('#product-catalog')!.scrollIntoView({behavior:'smooth'});};
document.querySelectorAll<HTMLButtonElement>('.product-add').forEach(button=>button.onclick=()=>{document.dispatchEvent(new CustomEvent('catalog:add',{detail:{name:button.dataset.productName,price:Number(button.dataset.productPrice),id:button.dataset.productId,image:button.dataset.productImage}}));document.querySelector('#catalog-feedback')!.textContent=`${button.dataset.productName} adicionado ao orçamento. Você pode alterar o preço na tabela de itens.`;});render();
</script>
<style>
.product-catalog{margin-top:26px;scroll-margin-top:20px}.catalog-heading{display:flex;align-items:center;justify-content:space-between;gap:20px}.catalog-heading h2{margin:10px 0;font-size:23px}.catalog-heading p{color:#6c7d74;font-size:13px}.back-to-quote{font-size:12px;color:#1e634d;white-space:nowrap}.price-notice{background:#f3f7ef;color:#566c4b;padding:15px;border-radius:7px;font-size:12px;line-height:1.7}.catalog-filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px;margin:22px 0}.filter-field{display:flex;flex-direction:column;gap:8px}select{width:100%;font:inherit;padding:11px 12px;border:1px solid #dce5df;border-radius:6px;background:white;color:#213a30;min-width:0}#product-results,#products-page,#catalog-feedback{font-size:12px;color:#597165}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.product-card{border:1px solid #e0e7e3;border-radius:9px;overflow:hidden;background:white;display:flex;flex-direction:column}.product-card[hidden]{display:none}.product-photo{height:170px;background:white;padding:14px}.product-photo img{height:100%;width:100%;object-fit:contain}.product-card-body{display:flex;flex-direction:column;align-items:flex-start;padding:16px;flex:1}.product-category{color:#608574;font-size:9px;text-transform:uppercase;letter-spacing:.6px}.product-card h3{font:600 12px/1.6 Manrope,sans-serif;margin:9px 0;overflow-wrap:anywhere}.product-brand{font-size:10px;color:#788b7e;margin-bottom:16px}.product-price{font:800 21px Manrope,sans-serif;color:#153f31;margin-top:auto}.product-condition{font-size:10px;color:#758577;margin:7px 0}.product-source{font-size:10px;color:#3b7760;line-height:1.6;margin:6px 0 15px}.product-add{width:100%;background:#1e634d;color:white;font-size:11px}.catalog-pagination{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:24px}button:disabled{opacity:.4;cursor:default}.product-add:focus-visible,select:focus-visible{outline:3px solid #25aa90;outline-offset:3px}@media(max-width:1200px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-filters{grid-template-columns:1fr}.catalog-heading{align-items:flex-start;flex-direction:column}.product-card-body{padding:12px}.product-photo{height:145px}}@media(max-width:380px){.product-grid{grid-template-columns:1fr}}
</style>
