---
import catalog from '../data/products.json';
const categories = [...new Set(catalog.products.map(p => p.category))];
const formatPrice = (value: number) => new Intl.NumberFormat('pt-BR', {style:'currency',currency:'BRL'}).format(value);
const date = new Date(catalog.fetchedAt).toLocaleDateString('pt-BR', {timeZone:'America/Fortaleza'});
const brands = [...new Set(catalog.products.map(p => p.brand))].sort((a,b)=>a.localeCompare(b,'pt-BR'));
const productDate = (value: string) => new Date(value).toLocaleDateString('pt-BR', {timeZone:'America/Fortaleza'});
---
<section id="product-catalog" class="product-catalog">
  <div class="catalog-heading"><div><h1>Produtos</h1><p>{catalog.products.length} itens para seu orçamento.</p></div><a href="/#quote" class="back-to-quote">Voltar ao orçamento</a></div>
  <div class="selection-bar" hidden><span id="selection-count"></span><a class="selection-link" href="/#quote">Continuar orçamento →</a></div><details class="price-details"><summary>Sobre os preços e as fontes</summary><p class="price-notice">Catálogo ampliado em {date}. Valores de referência sem frete, instalação ou margem de revenda. Cada produto informa a data da pesquisa, a loja e a condição do preço. Confira a oferta na fonte e ajuste seu valor de venda no orçamento. A quantidade e a embalagem correspondem ao anúncio: unidade, par, rolo ou kit, conforme a descrição.</p></details>
  <div class="catalog-filters"><div class="filter-field"><label for="product-search">Buscar produto</label><input id="product-search" type="search" placeholder="Busque por modelo, produto ou marca…"/></div><div class="filter-field"><label for="product-category">Categoria</label><select id="product-category"><option value="">Todas as categorias</option>{categories.map(c=><option value={c}>{c}</option>)}</select></div><div class="filter-field"><label for="product-brand">Marca</label><select id="product-brand"><option value="">Todas as marcas</option>{brands.map(b=><option value={b}>{b}</option>)}</select></div></div>
  <p id="product-results" role="status" aria-live="polite"></p>
  <div class="product-grid">{catalog.products.map(p=><article class="product-card" data-name={p.name} data-brand={p.brand} data-category={p.category}>
    <div class="product-photo"><img src={p.image} alt={p.name} width="240" height="180" loading="lazy" decoding="async"/></div>
    <div class="product-card-body"><span class="product-category">{p.category}</span><h3>{p.name}</h3><span class="product-brand">{p.brand}</span><strong class="product-price">{formatPrice(p.price)}</strong><span class="product-condition">{p.priceBasis} · Sem frete</span><span class="product-condition">Pesquisado em {productDate(p.fetchedAt)}</span><a href={p.source} target="_blank" rel="noopener noreferrer" class="product-source">Fonte: {p.sourceName} ↗</a><button type="button" class="product-add" data-product-name={p.name} data-product-price={p.price} data-product-id={p.id} data-product-image={p.image}>＋ Adicionar ao orçamento</button></div>
  </article>)}</div>
  <div class="catalog-pagination"><button type="button" id="products-prev">← Anterior</button><span id="products-page"></span><button type="button" id="products-next">Próxima →</button></div>
  <p id="catalog-feedback" role="status" aria-live="polite"></p>
</section>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')];
const search=document.querySelector<HTMLInputElement>('#product-search')!;
const category=document.querySelector<HTMLSelectElement>('#product-category')!;
const brand=document.querySelector<HTMLSelectElement>('#product-brand')!;
const previous=document.querySelector<HTMLButtonElement>('#products-prev')!;
const next=document.querySelector<HTMLButtonElement>('#products-next')!;
const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
let page=0;const pageSize=12;
function render(){const terms=normalize(search.value.trim()).split(/\s+/).filter(Boolean);const filtered=cards.filter(c=>terms.every(term=>normalize(`${c.dataset.name} ${c.dataset.brand} ${c.dataset.category}`).includes(term))&&(!category.value||c.dataset.category===category.value)&&(!brand.value||c.dataset.brand===brand.value));const pages=Math.max(1,Math.ceil(filtered.length/pageSize));page=Math.min(page,pages-1);const visible=new Set(filtered.slice(page*pageSize,(page+1)*pageSize));cards.forEach(c=>c.hidden=!visible.has(c));document.querySelector('#product-results')!.textContent=`${filtered.length} produto(s) encontrado(s)`;document.querySelector('#products-page')!.textContent=`Página ${page+1} de ${pages}`;previous.disabled=page===0;next.disabled=page>=pages-1;}
search.addEventListener('input',()=>{page=0;render();});category.addEventListener('change',()=>{page=0;render();});brand.addEventListener('change',()=>{page=0;render();});
previous.onclick=()=>{page--;render();document.querySelector('#product-catalog')!.scrollIntoView({behavior:'smooth'});};next.onclick=()=>{page++;render();document.querySelector('#product-catalog')!.scrollIntoView({behavior:'smooth'});};
type Selection={id:string;name:string;price:number;image?:string;qty:number};
const queueKey='orcaseg-catalog-items-v1';
let selected:Selection[]=[];
function showSelection(){const count=selected.reduce((sum,item)=>sum+item.qty,0);document.querySelector<HTMLElement>('.selection-bar')!.hidden=count===0;document.querySelector('#selection-count')!.textContent=count+' produto(s) selecionado(s)';}
function readSelection(){try{const data=JSON.parse(sessionStorage.getItem(queueKey)||'[]');selected=Array.isArray(data)?data.filter(p=>p&&typeof p.id==='string'&&typeof p.name==='string'&&Number.isFinite(p.price)&&p.price>0&&Number.isInteger(p.qty)&&p.qty>0&&p.qty<=999):[];}catch{selected=[];}showSelection();}
document.querySelectorAll<HTMLButtonElement>('.product-add').forEach(button=>button.onclick=()=>{
  const next=structuredClone(selected);
  const existing=next.find(item=>item.id===button.dataset.productId);
  if(existing){if(existing.qty>=999)return;existing.qty++;}
  else next.push({id:button.dataset.productId!,name:button.dataset.productName!,price:Number(button.dataset.productPrice),image:button.dataset.productImage,qty:1});
  try{sessionStorage.setItem(queueKey,JSON.stringify(next));selected=next;showSelection();document.querySelector('#catalog-feedback')!.textContent=button.dataset.productName+' selecionado. Continue o orçamento para ajustar os valores.';}
  catch{document.querySelector('#catalog-feedback')!.textContent='Não foi possível selecionar. Verifique o armazenamento do navegador.';}
});
readSelection();window.addEventListener('pageshow',readSelection);render();
</script>
<style>
.product-catalog{margin:0;border:0;padding:0;background:none}.catalog-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.catalog-heading h1{font-size:28px;letter-spacing:-.8px;font-weight:600;margin:0}.catalog-heading p{font-size:13px;color:#65748a;margin:7px 0 0}.back-to-quote{font-size:12px;white-space:nowrap}.price-details{font-size:12px;color:#65748a;margin-bottom:20px}.price-details summary{cursor:pointer}.price-notice{font-size:12px;line-height:1.7;max-width:850px}.catalog-filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:14px;margin:20px 0}.filter-field{display:flex;flex-direction:column;gap:7px}select{font:inherit;padding:10px 11px}#product-results,#products-page,#catalog-feedback{font-size:12px;color:#65748a}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.product-card{border:1px solid #e1e7ef;border-radius:7px;background:white;overflow:hidden;display:flex;flex-direction:column}.product-card[hidden]{display:none}.product-photo{height:165px;padding:16px}.product-photo img{width:100%;height:100%;object-fit:contain}.product-card-body{display:flex;flex-direction:column;align-items:flex-start;padding:16px;flex:1}.product-category{font-size:10px;color:#65748a}.product-card h3{font-size:13px;font-weight:500;line-height:1.6;margin:8px 0;overflow-wrap:anywhere}.product-brand{font-size:11px;color:#65748a;margin-bottom:14px}.product-price{font-size:21px;font-weight:600;letter-spacing:-.5px;color:#154d86;margin-top:auto}.product-condition{font-size:10px;color:#65748a;margin-top:6px}.product-source{font-size:10px;margin:12px 0}.product-add{font-size:12px;width:100%;background:#edf5ff;color:#075ebc;border-color:#d9e8fa}.product-add:hover{background:#e1efff}.catalog-pagination{display:flex;justify-content:center;align-items:center;gap:18px;margin:24px 0}button:disabled{opacity:.4;cursor:default}.selection-bar{position:sticky;top:12px;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid #c8ddf3;background:white;border-radius:6px;padding:12px 16px;margin-bottom:20px;font-size:13px}.selection-bar[hidden]{display:none}.selection-link{color:#fff;background:#075ebc;border-radius:5px;padding:10px 13px;text-decoration:none;font-size:12px}
@media(max-width:1000px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-filters{grid-template-columns:1fr}.product-card-body{padding:12px}.product-photo{height:140px}.catalog-heading{gap:12px}.catalog-heading h1{font-size:25px}.selection-bar{font-size:11px;padding:10px;gap:8px}.selection-link{font-size:11px;padding:10px}}@media(max-width:380px){.product-grid{grid-template-columns:1fr}}
</style>
